# ---------------------------------------------------------------------------
# Meme'd backend — environment variables
# Copy to `.env` for local development. Never commit the real `.env`.
# ---------------------------------------------------------------------------

# Runtime environment: development | test | production
NODE_ENV=development

# HTTP port the API listens on
PORT=4000

# MongoDB connection string. MUST point at a replica set (needed for
# transactions). Atlas M0 qualifies. Local example (docker compose):
#   mongodb://localhost:27017/memed?replicaSet=rs0
MONGODB_URI=mongodb://localhost:27017/memed?replicaSet=rs0

# Secret used to sign JWTs. Required, at least 32 characters.
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-characters

# JWT lifetime (e.g. 7d, 12h, 60m)
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed browser origins. Required in production.
CORS_ORIGIN=http://localhost:3000

# Optional. If set, enables the live-campaign-list cache. App runs fine without it.
# REDIS_URL=redis://localhost:6379
REDIS_URL=

# Live-campaign list cache TTL in seconds
CAMPAIGN_CACHE_TTL_SECONDS=30

# Spike detection: minimum absolute view increase to be eligible for flagging
SPIKE_MIN_DELTA=10000

# Spike detection: minimum views-per-minute growth rate to be flagged
SPIKE_RATE_PER_MIN=1000
